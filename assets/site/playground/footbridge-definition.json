{"kind":"component","id":"c2b6f0c7-f22e-44d0-8b5b-b223dc4efccf","type":"c4e1d7a2-58b6-4f03-8e2a-1b9f6d3a7c05","name":"Support (Alpaca4d)","nick":"Pin","desc":"A support. Rigid: fixes the node along and about the axes of the Position's plane you choose. Elastic: a spring along or about each axis of the plane. Compression Only: holds the node only while it pushes into the support, along the plane's Z, and lets it lift - after a gap, if there is one.\nElastic and Compression Only never fix the node themselves, so a Rigid support on the same point can hold what they leave free: a pinned bearing that can lift is a Compression Only support with a Rigid one holding Tx and Ty only.\nReaction Force gives a spring support a row of its own, with the spring's force.","box":[993,417,82,144],"pivot":[1032,489],"inputs":[{"id":"b25901cc-3cac-40e2-aab2-79966aefc3d9","name":"Position","nick":"Position","box":[995,419,22,20],"src":["b37ea70e-6df6-4481-9d1f-7385d0112069"]},{"id":"9f8e9853-3c5f-49da-8002-abf103941b3c","name":"Tx","nick":"Tx","box":[995,439,22,20],"src":[]},{"id":"a8ad7782-00de-4919-9421-09f6c5b66dd0","name":"Ty","nick":"Ty","box":[995,459,22,20],"src":[]},{"id":"1e4a8029-9d29-4acc-8dcb-48dc65bac109","name":"Tz","nick":"Tz","box":[995,479,22,20],"src":[]},{"id":"99bf9579-ab1c-42d2-bf15-91cf2a4bd48a","name":"Rx","nick":"Rx","box":[995,499,22,20],"src":[]},{"id":"fa308b13-cc73-40e3-938a-4b0f50fded51","name":"Ry","nick":"Ry","box":[995,519,22,20],"src":["e1197066-94f3-4692-98e5-70e1d783a20a"]},{"id":"5dea4a70-5d8c-4353-bf8d-f74830c1b0b4","name":"Rz","nick":"Rz","box":[995,539,22,20],"src":["e1197066-94f3-4692-98e5-70e1d783a20a"]}],"outputs":[{"id":"46a91380-b567-402d-b949-783892da7e2b","name":"Support","nick":"Support","box":[1047,419,26,140],"src":[]}],"unit":"Support Rigid"},
