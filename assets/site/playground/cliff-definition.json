{"kind":"component","id":"d7f07b0e-4e1f-449f-b59f-ea4162ddc049","type":"c4e1d7a2-58b6-4f03-8e2a-1b9f6d3a7c05","name":"Support (Alpaca4d)","nick":"Support","desc":"A support. Rigid: fixes the node along and about the axes of the Position's plane you choose. Elastic: a spring along or about each axis of the plane. Compression Only: holds the node only while it pushes into the support, along the plane's Z, and lets it lift - after a gap, if there is one.\nElastic and Compression Only never fix the node themselves, so a Rigid support on the same point can hold what they leave free: a pinned bearing that can lift is a Compression Only support with a Rigid one holding Tx and Ty only.\nReaction Force gives a spring support a row of its own, with the spring's force.","box":[533,417,82,144],"pivot":[572,489],"inputs":[{"id":"8985c91c-a790-4750-a801-cc5a8f6f4c51","name":"Position","nick":"Position","box":[535,419,22,20],"src":["5429c889-ab7e-4d6c-8820-fe01e47f0155"]},{"id":"3c4b57b7-b20f-4ea0-a318-c0ac08da6baf","name":"Tx","nick":"Tx","box":[535,439,22,20],"src":[]},{"id":"e6958fde-b44e-45cd-aee6-1d9981d10e81","name":"Ty","nick":"Ty","box":[535,459,22,20],"src":[]},{"id":"f0ad7071-c7d9-4648-89f3-6ef6eb3d790d","name":"Tz","nick":"Tz","box":[535,479,22,20],"src":[]},{"id":"34724b0c-f430-409d-a6a1-bd8c09fd14e6","name":"Rx","nick":"Rx","box":[535,499,22,20],"src":[]},{"id":"455ce28d-f39e-47db-a5c2-dfc9500679fb","name":"Ry","nick":"Ry","box":[535,519,22,20],"src":[]},{"id":"55633892-ed11-43f9-a46c-e27794f57323","name":"Rz","nick":"Rz","box":[535,539,22,20],"src":[]}],"outputs":[{"id":"917f7219-20c6-4130-811a-387a98b65a3f","name":"Support","nick":"Support","box":[587,419,26,140],"src":[]}],"unit":"Support Rigid"},
