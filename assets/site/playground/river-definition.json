{"kind":"component","id":"ab0f0a07-4111-431c-80be-9239b8efac6d","type":"c4e1d7a2-58b6-4f03-8e2a-1b9f6d3a7c05","name":"Support (Alpaca4d)","nick":"Pin","desc":"A support. Rigid: fixes the node along and about the axes of the Position's plane you choose. Elastic: a spring along or about each axis of the plane. Compression Only: holds the node only while it pushes into the support, along the plane's Z, and lets it lift - after a gap, if there is one.\nElastic and Compression Only never fix the node themselves, so a Rigid support on the same point can hold what they leave free: a pinned bearing that can lift is a Compression Only support with a Rigid one holding Tx and Ty only.\nReaction Force gives a spring support a row of its own, with the spring's force.","box":[995,417,82,144],"pivot":[1034,489],"inputs":[{"id":"bde9c29e-e7b4-4c73-94db-36f03c3c6138","name":"Position","nick":"Position","box":[997,419,22,20],"src":["0b0312b5-f21a-499e-96bd-9dd67b28b621"]},{"id":"809bb474-012b-4050-9f27-3118d8c549d1","name":"Tx","nick":"Tx","box":[997,439,22,20],"src":[]},{"id":"757012f8-eb9c-418a-bea1-806536a6b37d","name":"Ty","nick":"Ty","box":[997,459,22,20],"src":[]},{"id":"b5e464ca-e434-4e58-97d2-4b2258f5fae7","name":"Tz","nick":"Tz","box":[997,479,22,20],"src":[]},{"id":"9a54b814-194a-4f10-bb3b-aaf9508aafd7","name":"Rx","nick":"Rx","box":[997,499,22,20],"src":[]},{"id":"0bb440af-8ad6-4d53-901a-ccfc2ccade4f","name":"Ry","nick":"Ry","box":[997,519,22,20],"src":["a711d510-ae4d-4557-b790-52a0e7b0be51"]},{"id":"9f261d4c-52b3-4573-bcd9-51e55d486b00","name":"Rz","nick":"Rz","box":[997,539,22,20],"src":["a711d510-ae4d-4557-b790-52a0e7b0be51"]}],"outputs":[{"id":"505f3be5-e13a-4da1-97fb-1e543d146f89","name":"Support","nick":"Support","box":[1049,419,26,140],"src":[]}],"unit":"Support Rigid"},
