{"kind":"component","id":"8d638f07-6180-45fc-9ace-bdbffbb5d9ea","type":"f6d1efd4-82a3-4a0f-b4b7-6dd0ee9fcade","name":"Model View (Alpaca4d)","nick":"The wall","desc":"Draw the model and its results in the viewport.\nTick one or more results under Results - displacements, beam forces and stresses, shell forces and stresses, solid stresses, reactions - to draw them together, each with its own component and unit. Under Beam forces, tick any of N, Vy, Vz, T, My and Mz to draw their diagrams together. They need a model from Run Analysis or another analysis. Each element is coloured by one result: an element's own stress or force before the displacement, which colours the rest.\nWith none ticked, the elements are coloured by element, section or material.\nNode and element ids, section names, local axes, end releases, loads and supports can be drawn over either, from the Elements, Loads and Supports menus.\nElementId shows only some of the elements and greys the rest, so what you are looking at stays in the model around it.\nGeometry hands out what is drawn as coloured meshes and lines - move it, or bake it.\nWith Extruded on, beam stresses that differ across a section - σx, σMy, σMz, τV, τT, Von Mises - are painted point by point over it; drawn as lines, each section shows its worst.\nA vibration or buckling mode is drawn at deformation scale 1 with its largest movement as far off the model as the diagrams stand; any other displacement at true size. On a natural vibration or buckling model the scale runs from -2 to 2, so Animate swings the mode both ways.","box":[1493.5,524,230,281],"pivot":[1607,586],"inputs":[{"id":"1ea6d734-82c4-4d1d-b9fb-7668eddceed9","name":"AlpacaModel","nick":"AlpacaModel","box":[1495.5,526,96.5,20],"src":["eee127a6-71f9-42dd-93a7-683010eaaba5"]},{"id":"680f0073-b57a-4dce-a157-fcc79c748434","name":"Step","nick":"Step","box":[1495.5,546,96.5,20],"src":[]},{"id":"ad2ae5dd-1fd8-4936-909f-b120daec21c2","name":"ElementId","nick":"ElementId","box":[1495.5,566,96.5,20],"src":[]},{"id":"591f1e9d-bd1c-4f7b-8fee-8f8448a8d721","name":"Colors","nick":"Colors","box":[1495.5,586,96.5,20],"src":[]},{"id":"1414d1f5-6329-430e-9438-09c03546c7bf","name":"Range","nick":"Range","box":[1495.5,606,96.5,20],"src":[]},{"id":"058ee747-fe0e-41df-b04e-b7f81b503b7c","name":"LoadPattern","nick":"LP","box":[1495.5,626,96.5,20],"src":[]}],"outputs":[{"id":"ae65114d-ede2-45c0-8241-c445358cb9e5","name":"AlpacaModel","nick":"AlpacaModel","box":[1622,526,99.5,24],"src":[]},{"id":"5ec6e571-7105-440b-a267-233670ee86d2","name":"Geometry","nick":"Geometry","box":[1622,550,99.5,24],"src":[]},{"id":"114253b0-58ca-43ef-af09-2677655b2266","name":"Info","nick":"Info","box":[1622,574,99.5,24],"src":[]},{"id":"82fa13b7-2aa7-4efe-9418-d97de1a6187e","name":"Values","nick":"Values","box":[1622,598,99.5,24],"src":[]},{"id":"2d80cbe5-58a1-422a-b26c-ae9fbf233d88","name":"Colors","nick":"Colors","box":[1622,622,99.5,24],"src":[]}]},
{"kind":"component","id":"cc8f9e7b-857c-4d90-8e92-c241705566dd","type":"f6d1efd4-82a3-4a0f-b4b7-6dd0ee9fcade","name":"Model View (Alpaca4d)","nick":"The print","desc":"Draw the model and its results in the viewport.\nTick one or more results under Results - displacements, beam forces and stresses, shell forces and stresses, solid stresses, reactions - to draw them together, each with its own component and unit. Under Beam forces, tick any of N, Vy, Vz, T, My and Mz to draw their diagrams together. They need a model from Run Analysis or another analysis. Each element is coloured by one result: an element's own stress or force before the displacement, which colours the rest.\nWith none ticked, the elements are coloured by element, section or material.\nNode and element ids, section names, local axes, end releases, loads and supports can be drawn over either, from the Elements, Loads and Supports menus.\nElementId shows only some of the elements and greys the rest, so what you are looking at stays in the model around it.\nGeometry hands out what is drawn as coloured meshes and lines - move it, or bake it.\nWith Extruded on, beam stresses that differ across a section - σx, σMy, σMz, τV, τT, Von Mises - are painted point by point over it; drawn as lines, each section shows its worst.\nA vibration or buckling mode is drawn at deformation scale 1 with its largest movement as far off the model as the diagrams stand; any other displacement at true size. On a natural vibration or buckling model the scale runs from -2 to 2, so Animate swings the mode both ways.","box":[1493.5,1009,230,281],"pivot":[1607,1071],"inputs":[{"id":"a4faddd6-53d1-44e7-bdba-0a605b51802b","name":"AlpacaModel","nick":"AlpacaModel","box":[1495.5,1011,96.5,20],"src":["e3f52b41-6383-47e2-b554-eef1e5cc6bff"]},{"id":"2940e818-ba05-4ace-a66d-52206e8854c2","name":"Step","nick":"Step","box":[1495.5,1031,96.5,20],"src":[]},{"id":"88aeace6-3813-4578-8bef-414800d17805","name":"ElementId","nick":"ElementId","box":[1495.5,1051,96.5,20],"src":[]},{"id":"35ca7ffe-ba81-4fc4-8e43-c9fd28ecf83b","name":"Colors","nick":"Colors","box":[1495.5,1071,96.5,20],"src":[]},{"id":"97455795-570c-4c1e-acc3-5fb9b4184f80","name":"Range","nick":"Range","box":[1495.5,1091,96.5,20],"src":[]},{"id":"52afaa6c-e59f-4ab2-9fc3-7c3867a90b78","name":"LoadPattern","nick":"LP","box":[1495.5,1111,96.5,20],"src":[]}],"outputs":[{"id":"abbefc28-3f46-4fa5-9bca-68396f129d2d","name":"AlpacaModel","nick":"AlpacaModel","box":[1622,1011,99.5,24],"src":[]},{"id":"2aa5117b-2576-4195-a191-443d9a59b0e8","name":"Geometry","nick":"Geometry","box":[1622,1035,99.5,24],"src":[]},{"id":"c20d48f7-8c9d-4bed-b32f-d5894df00969","name":"Info","nick":"Info","box":[1622,1059,99.5,24],"src":[]},{"id":"c8ee005d-e3e4-4c07-9144-bd4786dd2b1d","name":"Values","nick":"Values","box":[1622,1083,99.5,24],"src":[]},{"id":"3e92ad2d-fb80-4216-bfa6-a6205c56f965","name":"Colors","nick":"Colors","box":[1622,1107,99.5,24],"src":[]}]},
