{"kind":"component","id":"afe619c4-8e28-4c59-a2c0-eb3c40128c71","type":"3b7d2e95-6a41-4c8f-9e1d-5f0a8c27b6d3","name":"Natural Vibration Analysis (Alpaca4d)","nick":"Natural Vibration","desc":"Solves the eigenvalue problem of the model and returns its modes, eigenvalues, periods and frequencies.\nIt needs no Analysis Settings - an eigenvalue problem has nothing to converge. Connect the assembled model, or an analysed one for the modes of the model it was analysed from - Section Optimiser's last design, say. Feed the solved model to Nodal Displacements to read a mode shape.\nThe modal report - masses, centre of mass, participation factors and mass ratios - is in the Modal Report menu below the component.","box":[1233,372,350,119],"pivot":[1332,424],"inputs":[{"id":"afb49de8-a47a-4aff-9d03-9b1c7aa31ec6","name":"AlpacaModel","nick":"AlpacaModel","box":[1235,374,82,33],"src":["51c8c6c5-ff99-4352-a477-dd416fa4df28"]},{"id":"a6134fe4-dbd7-474f-97ec-a949be075214","name":"Vibration Modes","nick":"Vibration Modes","box":[1235,407,82,33],"src":["5eba665a-b085-4191-93cb-59779861bdf8"]},{"id":"77cb7841-83a6-4349-ad50-20a4b17e66d7","name":"Solver","nick":"Solver","box":[1235,440,82,34],"src":[]}],"outputs":[{"id":"845211be-06b3-4510-891b-7019983b24fd","name":"AlpacaModel","nick":"AlpacaModel","box":[1347,374,234,20],"src":[]},{"id":"f2e5e12d-9a57-490b-b3dd-f6a39911ab43","name":"Eigenvalues","nick":"Eigenvalues","box":[1347,394,234,20],"src":[]},{"id":"9f02b56a-30c7-40c2-91ef-9820257df89b","name":"Period","nick":"Period","box":[1347,414,234,20],"src":[]},{"id":"79653fc3-d651-42c4-b9e7-0d51e3f2070e","name":"Frequencies","nick":"Frequencies","box":[1347,434,234,20],"src":[]},{"id":"2c907a2f-657d-4827-a336-e253030b8c2f","name":"log","nick":"log","box":[1347,454,234,20],"src":[]},{"id":"eb6a110d-4741-4efa-bc1d-3cc6e3c7fb28","name":"EigenValueAnalysis","nick":"EigenValueAnalysis","box":[1576,483,5,0],"src":[]},{"id":"580f3bfa-9815-4572-a98f-e8d32e04fae0","name":"TotalMassOfStructure","