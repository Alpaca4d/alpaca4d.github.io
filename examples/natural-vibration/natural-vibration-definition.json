{"kind":"component","id":"6b906569-973e-4cf6-acd8-dbe4359bc25d","type":"c4e1d7a2-58b6-4f03-8e2a-1b9f6d3a7c05","name":"Support (Alpaca4d)","nick":"Built in","desc":"A support. Rigid: fixes the node along and about the axes of the Position's plane you choose. Elastic: a spring along or about each axis of the plane. Compression Only: holds the node only while it pushes into the support, along the plane's Z, and lets it lift - after a gap, if there is one.\nElastic and Compression Only never fix the node themselves, so a Rigid support on the same point can hold what they leave free: a pinned bearing that can lift is a Compression Only support with a Rigid one holding Tx and Ty only.\nReaction Force gives a spring support a row of its own, with the spring's force.","box":[893,832,121,188],"pivot":[952,904],"inputs":[{"id":"3de3bc78-668a-4ba3-9ff2-57d9b09c234c","name":"Position","nick":"Position","box":[895,834,42,20],"src":["bee20109-a74c-4359-9f19-96a8c46120da"]},{"id":"93346fb8-50e3-40e0-a17a-74ab3e8595b1","name":"Tx","nick":"Tx","box":[895,854,42,20],"src":[]},{"id":"1cee2c74-22ba-4a88-b6c8-85805f93693a","name":"Ty","nick":"Ty","box":[895,874,42,20],"src":[]},{"id":"75c99bc7-a64f-477e-916c-6a8be492f67b","name":"Tz","nick":"Tz","box":[895,894,42,20],"src":[]},{"id":"9eb796bf-d3d1-4f67-be4a-36a38d3088ac","name":"Rx","nick":"Rx","box":[895,914,42,20],"src":[]},{"id":"abd22134-3095-4a7c-862c-8d1328d406a6","name":"Ry","nick":"Ry","box":[895,934,42,20],"src":[]},{"id":"97363475-49c8-4774-9770-ac7dc140b582","name":"Rz","nick":"Rz","box":[895,954,42,20],"src":[]}],"outputs":[{"id":"51e0046b-e9b0-4af8-a1c0-b6f0ffbc584a","name":"Support","nick":"Support","box":[967,834,45,140],"src":[]}],"unit":"Support Rigid"},
