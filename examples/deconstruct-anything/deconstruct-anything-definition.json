{"kind":"group","id":"c5b106e5-df2e-4eae-8df7-6aa9d7f8a95e","type":"c552a431-af5b-46a9-a8a4-0fcbc27ef596","name":"Group","nick":"3 - The beam opened, then its section, then the section's material","desc":"A group of Grasshopper objects","box":[0,0,0,0],"colour":[50,235,108,63],"members":["e33b9393-0f3c-457d-ab48-1272cf31a1da","183c5f1e-cfc5-4720-9503-ce3acf9054eb","0add7012-c87c-4432-8601-504c6864d665","59145adc-7d95-4bb2-ad6b-cd399745b2a2","7882b1f9-0d33-44dc-8fec-bb8510c173cd","6094ac28-48ce-4ed9-9b70-5ce6af9b8335","4626c593-07a2-46bd-804b-3fa268a6f4fe","2a80f5a6-33dc-475a-9cf9-332f2e1cdc98"]},
